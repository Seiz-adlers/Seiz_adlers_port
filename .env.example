# Copy to .env.local (development) or set in your host's dashboard (production).

# Contact form delivery — https://resend.com (free tier is enough).
RESEND_API_KEY=
# Where enquiries are sent. Defaults to the email in data/site.ts.
CONTACT_TO_EMAIL=seizadlers@gmail.com
# Sender address. Must be on a domain verified in Resend (e.g. hello@seizadlers.com).
# Until a domain is verified, Resend's onboarding@resend.dev works for testing.
CONTACT_FROM_EMAIL=Seiz Adlers Website <hello@seizadlers.com>
